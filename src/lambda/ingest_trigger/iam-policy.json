{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ReadIngestQueue",
            "Effect": "Allow",
            "Action": [
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:GetQueueAttributes"
            ],
            "Resource": "arn:aws:sqs:ap-south-1:<ACCOUNT_B_ID>:platform-ingest-queue"
        },
        {
            "Sid": "WriteOwnLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:ap-south-1:<ACCOUNT_B_ID>:log-group:/aws/lambda/platform-ingest-trigger",
                "arn:aws:logs:ap-south-1:<ACCOUNT_B_ID>:log-group:/aws/lambda/platform-ingest-trigger:*"
            ]
        },
        {
            "Sid": "StartIngestWorkflow",
            "Effect": "Allow",
            "Action": "states:StartExecution",
            "Resource": "arn:aws:states:ap-south-1:<ACCOUNT_B_ID>:stateMachine:platform-ingest-workflow"
        }
    ]
}
