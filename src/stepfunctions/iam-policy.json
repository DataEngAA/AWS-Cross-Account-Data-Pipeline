{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "RunEtlJob",
            "Effect": "Allow",
            "Action": [
                "glue:StartJobRun",
                "glue:GetJobRun",
                "glue:GetJobRuns",
                "glue:BatchStopJobRun"
            ],
            "Resource": "arn:aws:glue:ap-south-1:<ACCOUNT_B_ID>:job/platform-etl-products"
        },
        {
            "Sid": "RunAthenaQuery",
            "Effect": "Allow",
            "Action": [
                "athena:StartQueryExecution",
                "athena:GetQueryExecution",
                "athena:GetQueryResults",
                "athena:StopQueryExecution",
                "athena:GetWorkGroup"
            ],
            "Resource": "arn:aws:athena:ap-south-1:<ACCOUNT_B_ID>:workgroup/platform-analytics"
        },
        {
            "Sid": "CatalogForPartitionRepair",
            "Effect": "Allow",
            "Action": [
                "glue:GetDatabase",
                "glue:GetTable",
                "glue:GetPartition",
                "glue:GetPartitions",
                "glue:BatchGetPartition",
                "glue:CreatePartition",
                "glue:BatchCreatePartition"
            ],
            "Resource": [
                "arn:aws:glue:ap-south-1:<ACCOUNT_B_ID>:catalog",
                "arn:aws:glue:ap-south-1:<ACCOUNT_B_ID>:database/platform_curated",
                "arn:aws:glue:ap-south-1:<ACCOUNT_B_ID>:table/platform_curated/products"
            ]
        },
        {
            "Sid": "AthenaListsBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an"
        },
        {
            "Sid": "AthenaReadsCuratedWritesResults",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": [
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/curated/*",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/athena-results/*"
            ]
        },
        {
            "Sid": "UpdateStatusInAccountA",
            "Effect": "Allow",
            "Action": "sts:AssumeRole",
            "Resource": "arn:aws:iam::<ACCOUNT_A_ID>:role/producer-state-writer"
        },
        {
            "Sid": "SendAlerts",
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "arn:aws:sns:ap-south-1:<ACCOUNT_B_ID>:platform-alerts"
        }
    ]
}
