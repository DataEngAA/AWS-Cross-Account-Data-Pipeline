{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListCuratedBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an"
        },
        {
            "Sid": "WriteOutputs",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/curated/*",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/curated_$folder$",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/quarantine/*",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/quarantine_$folder$",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/dq-results/*",
                "arn:aws:s3:::platform-aws-<ACCOUNT_B_ID>-ap-south-1-an/dq-results_$folder$"
            ]
        },
        {
            "Sid": "ListProducerRaw",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::producer-aws-<ACCOUNT_A_ID>-ap-south-1-an",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "raw",
                        "raw/*"
                    ]
                }
            }
        },
        {
            "Sid": "ReadProducerRaw",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::producer-aws-<ACCOUNT_A_ID>-ap-south-1-an/raw/*"
        },
        {
            "Sid": "ReadRdsSecret",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:aws:secretsmanager:ap-south-1:<ACCOUNT_B_ID>:secret:rds!db-e43eadd0-1ba5-45e2-9ea1-47ad1486f443-yu7Ha8"
        }
    ]
}
