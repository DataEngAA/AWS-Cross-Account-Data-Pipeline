{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "PlatformMayAssume",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::<ACCOUNT_B_ID>:root"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
                "ArnEquals": {
                    "aws:PrincipalArn": "arn:aws:iam::<ACCOUNT_B_ID>:role/platform-workflow-role"
                }
            }
        }
    ]
}
